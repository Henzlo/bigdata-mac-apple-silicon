*.tar
*.tar.gz
*.img
*.image

# ── Docker Compose override files ────────────────────────
docker-compose.override.yml
docker-compose.local.yml

# ── Environment overrides ─────────────────────────────────
.env
.env.local
.env.override
*.local.env

# ── Hadoop & Hive local data ──────────────────────────────
hadoop/dfs/
hadoop/yarn/
hive-metastore/
metastore_db/
derby.log

# ── Spark local data ──────────────────────────────────────
spark-warehouse/
spark-events/

